# =============================================================================
# Django Configuration
# =============================================================================

# Secret key for cryptographic signing (CHANGE IN PRODUCTION!)
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - MUST be False in production
# When True: allows HTTP cookies, detailed error pages
# When False: requires HTTPS cookies, generic error pages
DEBUG=True

# Allowed hosts for the Django application
# In production, set to your domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# CORS Configuration
# =============================================================================

# Origins allowed to make requests to the API
# Must include your frontend URL(s)
# Development example:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:3000

# Production example (uncomment and modify):
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# CSRF Configuration (Production Only)
# =============================================================================

# Trusted origins for CSRF protection
# Required in production when frontend and backend are on different domains
# Leave empty for development (same-origin)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# Production Deployment Checklist
# =============================================================================
# Before deploying to production:
# 1. Set DEBUG=False
# 2. Generate new SECRET_KEY
# 3. Set ALLOWED_HOSTS to your domain
# 4. Set CORS_ALLOWED_ORIGINS to your frontend domain(s)
# 5. Set CSRF_TRUSTED_ORIGINS to your frontend domain(s)
# 6. Ensure HTTPS is enabled (required for secure cookies)
# 7. Update database settings if not using SQLite
# 8. Set up proper logging and monitoring
